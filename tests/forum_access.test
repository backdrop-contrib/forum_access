/**
 * Verifies that access grants are independent per forum.
 *
 * Creates two forums with different settings (one open, one closed) and
 * confirms that an authenticated user can access the open forum and its
 * topics but is blocked from the closed forum and its topics.  This tests
 * the core promise of forum_access: per-forum isolation.
 */
class ForumAccess30MultiForumTestCase extends BackdropWebTestCase {

  protected $admin;
  protected $viewer;

  function setUp() {
    parent::setUp(array('taxonomy', 'comment', 'forum', 'acl', 'chain_menu_access', 'forum_access'));

    $forum_type = node_type_get_type('forum');
    $forum_type->settings['comment_enabled'] = 1;
    $forum_type->settings['comment_default'] = COMMENT_NODE_OPEN;
    node_type_save($forum_type);

    user_role_grant_permissions(BACKDROP_AUTHENTICATED_ROLE, array('post comments'));

    // Admin: can bypass node access so we can create content in any forum.
    $this->admin = $this->backdropCreateUser(array(
      'bypass node access',
      'administer forums',
      'administer taxonomy',
      'access administration pages',
      'create forum content',
    ));

    // Restricted user: authenticated, no content permissions.
    // This person should be able to access the open forum but not the closed one.
    $this->viewer = $this->backdropCreateUser(array());
  }

  function testForumIsolation() {
    $langcode = LANGUAGE_NONE;
    $this->backdropLogin($this->admin);

    // Forum A — open: authenticated users can view and create.
    $this->backdropPost('admin/structure/forum/add/forum', array(
      'name' => 'Open Forum',
      'forum_access[grants][checkboxes][view][authenticated]'   => 'authenticated',
      'forum_access[grants][checkboxes][create][authenticated]' => 'authenticated',
      'forum_access[grants][checkboxes][view][anonymous]'       => FALSE,
    ), t('Save'));
    $open_tid = db_query("SELECT tid FROM {taxonomy_term_data} WHERE name = :n",
      array(':n' => 'Open Forum'))->fetchField();
    $this->assertTrue($open_tid > 0, 'Open Forum created.');

    // Forum B — closed: no access for anyone (All-OFF).
    $this->backdropPost('admin/structure/forum/add/forum', array(
      'name' => 'Closed Forum',
      'forum_access[grants][checkboxes][view][authenticated]'   => FALSE,
      'forum_access[grants][checkboxes][create][authenticated]' => FALSE,
      'forum_access[grants][checkboxes][view][anonymous]'       => FALSE,
    ), t('Save'));
    $closed_tid = db_query("SELECT tid FROM {taxonomy_term_data} WHERE name = :n",
      array(':n' => 'Closed Forum'))->fetchField();
    $this->assertTrue($closed_tid > 0, 'Closed Forum created.');

    // Create one topic in each forum.
    $open_topic = entity_create('node', array(
      'type'   => 'forum',
      'title'  => 'Topic in Open Forum',
      'uid'    => $this->admin->uid,
      'status' => 1,
      'comment' => COMMENT_NODE_OPEN,
      'shadow' => FALSE,
      'taxonomy_forums' => array($langcode => array(array('tid' => $open_tid))),
      'body'   => array($langcode => array(array('value' => 'body', 'format' => 'plain_text'))),
    ));
    node_save($open_topic);

    $closed_topic = entity_create('node', array(
      'type'   => 'forum',
      'title'  => 'Topic in Closed Forum',
      'uid'    => $this->admin->uid,
      'status' => 1,
      'comment' => COMMENT_NODE_OPEN,
      'shadow' => FALSE,
      'taxonomy_forums' => array($langcode => array(array('tid' => $closed_tid))),
      'body'   => array($langcode => array(array('value' => 'body', 'format' => 'plain_text'))),
    ));
    node_save($closed_topic);

    // ----- Test as the restricted (authenticated-only) user -----
    $this->backdropLogin($this->viewer);

    // Open forum: viewer should have full read access.
    $this->backdropGet('forum/' . $open_tid);
    $this->assertResponse(200, 'Viewer can access the Open Forum listing.');
    $this->backdropGet('node/' . $open_topic->nid);
    $this->assertResponse(200, 'Viewer can access a topic in the Open Forum.');

    // Closed forum: viewer should be blocked on both the listing and topics.
    $this->backdropGet('forum/' . $closed_tid);
    $this->assertResponse(404, 'Viewer cannot access the Closed Forum listing.');
    $this->backdropGet('node/' . $closed_topic->nid);
    $this->assertResponse(403, 'Viewer cannot access a topic in the Closed Forum.');

    // ----- Admin bypasses all forum_access restrictions -----
    $this->backdropLogin($this->admin);
    $this->backdropGet('forum/' . $open_tid);
    $this->assertResponse(200, 'Admin can access the Open Forum.');
    $this->backdropGet('forum/' . $closed_tid);
    $this->assertResponse(200, 'Admin can access the Closed Forum.');
    $this->backdropGet('node/' . $closed_topic->nid);
    $this->assertResponse(200, 'Admin can access a topic in the Closed Forum.');
  }
}


/**
 * Verifies anonymous user access to forums with different access settings.
 *
 * Tests that anonymous users can browse forums that explicitly grant them
 * view access, but are blocked from forums that do not.  Also confirms that
 * even in a publicly-viewable forum anonymous users cannot create topics.
 */
class ForumAccess31AnonymousAccessTestCase extends BackdropWebTestCase {

  protected $admin;

  function setUp() {
    parent::setUp(array('taxonomy', 'comment', 'forum', 'acl', 'chain_menu_access', 'forum_access'));

    $forum_type = node_type_get_type('forum');
    $forum_type->settings['comment_enabled'] = 1;
    $forum_type->settings['comment_default'] = COMMENT_NODE_OPEN;
    node_type_save($forum_type);

    $this->admin = $this->backdropCreateUser(array(
      'bypass node access',
      'administer forums',
      'administer taxonomy',
      'access administration pages',
      'create forum content',
    ));
  }

  function testAnonymousAccess() {
    $langcode = LANGUAGE_NONE;
    $this->backdropLogin($this->admin);

    // Public forum: anonymous users are given view access.
    $this->backdropPost('admin/structure/forum/add/forum', array(
      'name' => 'Public Forum',
      'forum_access[grants][checkboxes][view][anonymous]'       => 'anonymous',
      'forum_access[grants][checkboxes][view][authenticated]'   => 'authenticated',
      'forum_access[grants][checkboxes][create][authenticated]' => 'authenticated',
      'forum_access[grants][checkboxes][create][anonymous]'     => FALSE,
    ), t('Save'));
    $public_tid = db_query("SELECT tid FROM {taxonomy_term_data} WHERE name = :n",
      array(':n' => 'Public Forum'))->fetchField();

    // Private forum: anonymous users have no access at all.
    $this->backdropPost('admin/structure/forum/add/forum', array(
      'name' => 'Private Forum',
      'forum_access[grants][checkboxes][view][anonymous]'       => FALSE,
      'forum_access[grants][checkboxes][create][anonymous]'     => FALSE,
      'forum_access[grants][checkboxes][view][authenticated]'   => 'authenticated',
      'forum_access[grants][checkboxes][create][authenticated]' => 'authenticated',
    ), t('Save'));
    $private_tid = db_query("SELECT tid FROM {taxonomy_term_data} WHERE name = :n",
      array(':n' => 'Private Forum'))->fetchField();

    // Create a topic in each forum.
    $public_topic = entity_create('node', array(
      'type'   => 'forum',
      'title'  => 'Public Topic',
      'uid'    => $this->admin->uid,
      'status' => 1,
      'comment' => COMMENT_NODE_OPEN,
      'shadow' => FALSE,
      'taxonomy_forums' => array($langcode => array(array('tid' => $public_tid))),
      'body'   => array($langcode => array(array('value' => 'body', 'format' => 'plain_text'))),
    ));
    node_save($public_topic);

    $private_topic = entity_create('node', array(
      'type'   => 'forum',
      'title'  => 'Private Topic',
      'uid'    => $this->admin->uid,
      'status' => 1,
      'comment' => COMMENT_NODE_OPEN,
      'shadow' => FALSE,
      'taxonomy_forums' => array($langcode => array(array('tid' => $private_tid))),
      'body'   => array($langcode => array(array('value' => 'body', 'format' => 'plain_text'))),
    ));
    node_save($private_topic);

    // Log out to become anonymous.
    $this->backdropLogout();

    // Public forum: anonymous can view topics but cannot create them.
    $this->backdropGet('forum/' . $public_tid);
    $this->assertResponse(200, 'Anonymous user can view the Public Forum listing.');
    $this->backdropGet('node/' . $public_topic->nid);
    $this->assertResponse(200, 'Anonymous user can view a topic in the Public Forum.');
    $this->backdropGet('node/add/forum/' . $public_tid);
    $this->assertResponse(403, 'Anonymous user cannot create a topic in the Public Forum.');

    // Private forum: anonymous is blocked from both the listing and topics.
    $this->backdropGet('forum/' . $private_tid);
    $this->assertResponse(404, 'Anonymous user cannot access the Private Forum listing.');
    $this->backdropGet('node/' . $private_topic->nid);
    $this->assertResponse(403, 'Anonymous user cannot access a topic in the Private Forum.');
  }
}


/**
 * Verifies that node_access grants are rebuilt when a topic is moved between forums.
 *
 * Creates two forums (one open, one closed), places a topic in the open
 * forum, confirms a viewer can read it, then moves the topic to the closed
 * forum and confirms the viewer is now denied.  This tests the
 * forum_access_node_update() code path and the Backdrop-specific
 * node_access_acquire_grants() call that follows acl_node_add_acl().
 */
class ForumAccess32TopicMoveTestCase extends BackdropWebTestCase {

  protected $admin;
  protected $viewer;

  function setUp() {
    parent::setUp(array('taxonomy', 'comment', 'forum', 'acl', 'chain_menu_access', 'forum_access'));

    $forum_type = node_type_get_type('forum');
    $forum_type->settings['comment_enabled'] = 1;
    $forum_type->settings['comment_default'] = COMMENT_NODE_OPEN;
    node_type_save($forum_type);

    user_role_grant_permissions(BACKDROP_AUTHENTICATED_ROLE, array('post comments'));

    $this->admin = $this->backdropCreateUser(array(
      'bypass node access',
      'administer forums',
      'administer taxonomy',
      'access administration pages',
      'create forum content',
      'edit any forum content',
    ));

    // Viewer: authenticated with no content permissions.
    $this->viewer = $this->backdropCreateUser(array());
  }

  function testTopicMove() {
    $langcode = LANGUAGE_NONE;
    $this->backdropLogin($this->admin);

    // Forum A: authenticated users can view and create.
    $this->backdropPost('admin/structure/forum/add/forum', array(
      'name' => 'Forum A (Open)',
      'forum_access[grants][checkboxes][view][authenticated]'   => 'authenticated',
      'forum_access[grants][checkboxes][create][authenticated]' => 'authenticated',
      'forum_access[grants][checkboxes][view][anonymous]'       => FALSE,
    ), t('Save'));
    $tid_a = db_query("SELECT tid FROM {taxonomy_term_data} WHERE name = :n",
      array(':n' => 'Forum A (Open)'))->fetchField();

    // Forum B: All-OFF — no access for authenticated or anonymous.
    $this->backdropPost('admin/structure/forum/add/forum', array(
      'name' => 'Forum B (Closed)',
      'forum_access[grants][checkboxes][view][authenticated]'   => FALSE,
      'forum_access[grants][checkboxes][create][authenticated]' => FALSE,
      'forum_access[grants][checkboxes][view][anonymous]'       => FALSE,
    ), t('Save'));
    $tid_b = db_query("SELECT tid FROM {taxonomy_term_data} WHERE name = :n",
      array(':n' => 'Forum B (Closed)'))->fetchField();

    // Create a topic in Forum A.
    $node = entity_create('node', array(
      'type'   => 'forum',
      'title'  => 'Moveable Topic',
      'uid'    => $this->admin->uid,
      'status' => 1,
      'comment' => COMMENT_NODE_OPEN,
      'shadow' => FALSE,
      'taxonomy_forums' => array($langcode => array(array('tid' => $tid_a))),
      'body'   => array($langcode => array(array('value' => 'body', 'format' => 'plain_text'))),
    ));
    node_save($node);

    // Viewer can access the topic while it lives in Forum A.
    $this->backdropLogin($this->viewer);
    $this->backdropGet('forum/' . $tid_a);
    $this->assertResponse(200, 'Viewer can access Forum A before the move.');
    $this->backdropGet('node/' . $node->nid);
    $this->assertResponse(200, 'Viewer can read the topic in Forum A.');

    // Admin moves the topic to Forum B by saving the node with the new forum.
    $this->backdropLogin($this->admin);
    $node->taxonomy_forums[$langcode][0]['tid'] = $tid_b;
    node_save($node);

    // After the move the viewer should be denied on both the node and Forum B.
    $this->backdropLogin($this->viewer);
    $this->backdropGet('node/' . $node->nid);
    $this->assertResponse(403, 'Viewer cannot read the topic after it is moved to Forum B.');
    $this->backdropGet('forum/' . $tid_b);
    $this->assertResponse(404, 'Viewer cannot access the Forum B listing.');

    // Verify Forum A is still accessible (the move didn't break anything).
    $this->backdropGet('forum/' . $tid_a);
    $this->assertResponse(200, 'Viewer can still access Forum A after the move.');
  }
}


/**
 * Tests that the Forum Access admin form warns when a role has the 'Post'
 * (grant_create) checkbox enabled but lacks the core 'create forum content'
 * permission. This mismatch would silently prevent people in that role from
 * creating forum topics.
 */
class ForumAccess20PermissionConflictWarningTestCase extends BackdropWebTestCase {

  protected $admin_user;

  function setUp() {
    parent::setUp(array('taxonomy', 'comment', 'forum', 'acl', 'chain_menu_access', 'forum_access'));

    // Enable comments on the forum content type so the test environment
    // matches a realistic site configuration.
    $forum_type = node_type_get_type('forum');
    $forum_type->settings['comment_enabled'] = 1;
    node_type_save($forum_type);

    // Create an admin user with the minimum permissions needed to manage forums.
    $this->admin_user = $this->backdropCreateUser(array(
      'access administration pages',
      'administer forums',
      'administer taxonomy',
      'bypass node access',
    ));
    $this->backdropLogin($this->admin_user);
  }

  /**
   * Helper: POST the forum-add form granting the given roles view/create access.
   *
   * @param string $name
   *   Display name for the new forum.
   * @param array $view_rids
   *   Role machine names to receive 'View' in Forum Access.
   * @param array $create_rids
   *   Role machine names to receive 'Post' in Forum Access.
   */
  protected function createForum($name, array $view_rids = array(), array $create_rids = array()) {
    $edit = array(
      'name'       => $name,
      'parent[0]'  => 0,
      // Always grant authenticated users view so the forum is browsable.
      'forum_access[grants][checkboxes][view][authenticated]' => 'authenticated',
    );
    foreach ($view_rids as $rid) {
      $edit['forum_access[grants][checkboxes][view][' . $rid . ']'] = $rid;
    }
    foreach ($create_rids as $rid) {
      $edit['forum_access[grants][checkboxes][create][' . $rid . ']'] = $rid;
    }
    $this->backdropPost('admin/structure/forum/add/forum', $edit, t('Save'));
    $this->assertResponse(200);
  }

  /**
   * Warning appears both as a post-save message and inline on the edit form
   * when a role has 'Post' in Forum Access but lacks 'create forum content'.
   */
  function testWarningAppearsWithConflict() {
    // Create a role that intentionally lacks 'create forum content'.
    $rid = $this->backdropCreateRole(array(), 'Forum Testers');

    $this->createForum('Warning Test Forum', array($rid), array($rid));

    // After save the warning should appear as a status message.
    $this->assertText('have Post access in Forum Access but lack the',
      'Post-save warning message appears when role lacks core permission.');
    $this->assertText('Forum Testers',
      'Conflicting role name appears in the post-save warning message.');

    // Navigate to the edit form — the inline warning should also appear.
    $tid = db_query("SELECT tid FROM {taxonomy_term_data} WHERE name = :name",
      array(':name' => 'Warning Test Forum'))->fetchField();
    $this->backdropGet("admin/structure/forum/edit/forum/$tid");
    $this->assertResponse(200);
    $this->assertText('have Post access in Forum Access but lack the',
      'Inline warning appears in the grants form on the forum edit page.');
    $this->assertText('Forum Testers',
      'Conflicting role name appears in the inline warning on the edit page.');
  }

  /**
   * No warning when a role has both the Forum Access 'Post' grant and the
   * 'create forum content' core permission — permissions are aligned.
   */
  function testNoWarningWhenPermissionsAligned() {
    $rid = $this->backdropCreateRole(
      array('create forum content', 'post comments'),
      'Aligned Testers'
    );

    $this->createForum('Aligned Forum', array($rid), array($rid));

    $this->assertNoText('have Post access in Forum Access but lack the',
      'No warning when role has both Forum Access Post and core permission.');
  }

  /**
   * No warning when a role lacks the Forum Access 'Post' grant entirely,
   * even if it has the core permission — this is intentional restriction.
   */
  function testNoWarningWhenPostNotGranted() {
    // Role has the core permission but is NOT given Post in Forum Access.
    $rid = $this->backdropCreateRole(array('create forum content'), 'Restricted Testers');

    // Only grant view, not create.
    $this->createForum('Restricted Forum', array($rid), array());

    $this->assertNoText('have Post access in Forum Access but lack the',
      'No warning when Forum Access Post grant is not enabled for the role.');
  }

  /**
   * Anonymous role with 'Post' checked is silently skipped — anonymous users
   * can never create content, so no warning is needed for that role.
   */
  function testNoWarningForAnonymousRole() {
    $this->createForum('Anon Forum', array(), array(BACKDROP_ANONYMOUS_ROLE));

    $this->assertNoText('have Post access in Forum Access but lack the',
      'No warning emitted for the anonymous role even with Post checked.');
  }
}
